generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id               String     @id @default(cuid())
  username         String     @unique
  passwordHash     String
  name             String
  nickname         String     @unique
  email            String     @unique
  phone            String     @unique
  phoneVerified    Boolean    @default(false)
  emailVerified    Boolean    @default(false)
  isAdmin          Boolean    @default(false)
  status           UserStatus @default(ACTIVE)
  trustToken       Float      @default(10)
  bio              String?  @db.Text
  passId           String?
  passName         String?
  passVerifiedAt   DateTime?
  squareWalletAddr String?
  pointWalletAddr  String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  products          Product[]
  orders            Order[]
  reviews           Review[]
  reports           Report[]
  pointLogs         PointLog[]
  tokenLogs         TokenLog[]
  verificationLogs  VerificationLog[]
  wishlists         Wishlist[]
  cartItems         CartItem[]
  walletCharges     WalletCharge[]

  @@map("users")
}

model TokenLog {
  id      String       @id @default(cuid())
  userId  String
  user    User         @relation(fields: [userId], references: [id])
  type    TokenLogType
  amount  Float
  balance Float
  memo    String?

  createdAt DateTime @default(now())

  @@map("token_logs")
}

model Product {
  id          String        @id @default(cuid())
  sellerId    String
  seller      User          @relation(fields: [sellerId], references: [id])
  title       String
  description String        @db.Text
  imageKey    String?
  fileKey     String
  fileType    FileType
  price       Int
  isVisible   Boolean       @default(true)
  status      ProductStatus @default(ON_SALE)
  tags        Json
  viewCount   Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order     Order?
  reviews   Review[]
  wishlists Wishlist[]
  cartItems CartItem[]

  @@map("products")
}

model Order {
  id            String      @id @default(cuid())
  buyerId       String
  buyer         User        @relation(fields: [buyerId], references: [id])
  productId     String      @unique
  product       Product     @relation(fields: [productId], references: [id])
  paymentMethod PayMethod
  paymentAmount Int
  usedPoint     Int?
  txHash        String?
  status        OrderStatus @default(PENDING_CONFIRMATION)
  autoConfirmAt DateTime
  settledAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports Report[]
  review  Review?

  @@map("orders")
}

model Review {
  id         String  @id @default(cuid())
  orderId    String  @unique
  order      Order   @relation(fields: [orderId], references: [id])
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  reviewerId String
  reviewer   User    @relation(fields: [reviewerId], references: [id])
  rating     Int
  content    String  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reviews")
}

model Report {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id])
  reporterId String
  reporter   User         @relation(fields: [reporterId], references: [id])
  reason     String       @db.Text
  imageKeys  Json
  status     ReportStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reports")
}

model PointLog {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  type      PointLogType
  category  PointCategory @default(ACTIVITY)
  amount    Int
  balance   Int
  memo      String?
  // 네이버 전환 시 해당 Exchange 레코드 ID
  exchangeId String?

  createdAt DateTime @default(now())

  @@index([userId, category])
  @@map("point_logs")
}

model NaverPointExchange {
  id            String   @id @default(cuid())
  userId        String
  amountPaid    Int      // 차감된 AISquare PAID 포인트
  direction     String   // "AISQUARE_TO_NAVER" or "NAVER_TO_AISQUARE"
  status        String   @default("PENDING") // PENDING / CONFIRMED / REJECTED
  naverTxId     String?  // 네이버 측 트랜잭션 ID
  fabricTxId    String?  // 체인코드 호출 TxID
  rejectReason  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@map("naver_point_exchanges")
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("wishlists")
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("cart_items")
}

model WalletCharge {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  amountKrw    Int
  squareAmount Int
  status       ChargeStatus @default(PENDING)
  txHash       String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("wallet_charges")
}

model AdminLog {
  id       String  @id @default(cuid())
  adminId  String
  action   String
  targetId String?
  meta     Json?

  createdAt DateTime @default(now())

  @@map("admin_logs")
}

model VerificationLog {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      VerificationType
  status    VerifyStatus
  meta      Json?

  createdAt DateTime @default(now())

  @@map("verification_logs")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum FileType {
  PDF
  JPG
  PNG
  MP4
  TXT
  ZIP
}

enum ProductStatus {
  ON_SALE
  SOLD
  HIDDEN
}

enum PayMethod {
  TOSS
  SQUARE
}

enum OrderStatus {
  PAYMENT_PENDING
  PAYMENT_COMPLETE
  PENDING_CONFIRMATION
  CONFIRMED
  SETTLEMENT_HOLD
  REFUNDED
}

enum ReportStatus {
  PENDING
  IN_REVIEW
  REFUNDED
  APPROVED
}

enum PointLogType {
  EARN_SALE
  EARN_BONUS
  USE_PURCHASE
  CHARGE
  CONVERT
  EARN_PAID         // PAID 포인트 적립 (충전, 결제 캐시백)
  EARN_ACTIVITY     // ACTIVITY 포인트 적립 (리뷰, 출석 등)
  NAVER_EXCHANGE_OUT // PAID → NaverPay (차감)
  NAVER_EXCHANGE_IN  // NaverPay → PAID (적립)
}

enum PointCategory {
  PAID      // 결제 포인트 — NaverPay 전환 가능
  ACTIVITY  // 웹 사용 포인트 — 전환 불가, 사이트 내 사용만
}

enum TokenLogType {
  EARN_CONFIRM
  EARN_REVIEW_5
  DEDUCT_REVIEW_LOW
  DEDUCT_REPORT
}

enum ChargeStatus {
  PENDING
  COMPLETED
  FAILED
}

enum VerificationType {
  PHONE
  EMAIL
}

enum VerifyStatus {
  SUCCESS
  FAILED
}

model TossPayment {
  id           String   @id @default(cuid())
  userId       String
  tossOrderId  String   @unique
  paymentKey   String?
  amount       Int
  purpose      String
  status       String   @default("PENDING")
  relatedId    String?
  rpGranted    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@map("toss_payments")
}


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(cuid())
  username      String     @unique
  passwordHash  String
  name          String
  email         String     @unique
  phone         String     @unique
  phoneVerified Boolean    @default(false)
  emailVerified Boolean    @default(false)
  isAdmin       Boolean    @default(false)
  status        UserStatus @default(ACTIVE)
  trustToken    Int        @default(30)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  products          Product[]
  orders            Order[]
  reviews           Review[]
  reports           Report[]
  pointLogs         PointLog[]
  tokenLogs         TokenLog[]
  verificationLogs  VerificationLog[]

  @@map("users")
}

model TokenLog {
  id      String       @id @default(cuid())
  userId  String
  user    User         @relation(fields: [userId], references: [id])
  type    TokenLogType
  amount  Int
  balance Int
  memo    String?

  createdAt DateTime @default(now())

  @@map("token_logs")
}

model Product {
  id          String        @id @default(cuid())
  sellerId    String
  seller      User          @relation(fields: [sellerId], references: [id])
  title       String
  description String        @db.Text
  imageKey    String?
  fileKey     String
  fileType    FileType
  priceEth    Decimal       @db.Decimal(30, 18)
  isVisible   Boolean       @default(true)
  status      ProductStatus @default(ON_SALE)
  tags        Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order?
  reviews Review[]

  @@map("products")
}

model Order {
  id            String      @id @default(cuid())
  buyerId       String
  buyer         User        @relation(fields: [buyerId], references: [id])
  productId     String      @unique
  product       Product     @relation(fields: [productId], references: [id])
  paymentMethod PayMethod
  amountEth     Decimal     @db.Decimal(30, 18)
  amountRp      Int?
  status        OrderStatus @default(PENDING_CONFIRMATION)
  autoConfirmAt DateTime
  settledAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports Report[]
  review  Review?

  @@map("orders")
}

model Review {
  id         String  @id @default(cuid())
  orderId    String  @unique
  order      Order   @relation(fields: [orderId], references: [id])
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  reviewerId String
  reviewer   User    @relation(fields: [reviewerId], references: [id])
  rating     Int
  content    String  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reviews")
}

model Report {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id])
  reporterId String
  reporter   User         @relation(fields: [reporterId], references: [id])
  reason     String       @db.Text
  imageKeys  Json
  status     ReportStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reports")
}

model PointLog {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  type      PointLogType
  amount    Int
  balance   Int
  memo      String?

  createdAt DateTime @default(now())

  @@map("point_logs")
}

model AdminLog {
  id       String  @id @default(cuid())
  adminId  String
  action   String
  targetId String?
  meta     Json?

  createdAt DateTime @default(now())

  @@map("admin_logs")
}

model VerificationLog {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      VerificationType
  status    VerifyStatus
  meta      Json?

  createdAt DateTime @default(now())

  @@map("verification_logs")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum FileType {
  PDF
  JPG
  PNG
  MP4
}

enum ProductStatus {
  ON_SALE
  SOLD
  HIDDEN
}

enum PayMethod {
  ETH
  RP
}

enum OrderStatus {
  PAYMENT_PENDING
  PAYMENT_COMPLETE
  PENDING_CONFIRMATION
  CONFIRMED
  SETTLEMENT_HOLD
  REFUNDED
}

enum ReportStatus {
  PENDING
  IN_REVIEW
  REFUNDED
  APPROVED
}

enum PointLogType {
  EARN_SALE
  EARN_BONUS
  USE_PURCHASE
  CHARGE
  CONVERT
}

enum TokenLogType {
  EARN_CONFIRM
  EARN_REVIEW_5
  DEDUCT_REVIEW_LOW
  DEDUCT_REPORT
}

enum VerificationType {
  PHONE
  EMAIL
}

enum VerifyStatus {
  SUCCESS
  FAILED
}

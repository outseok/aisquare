# Database (Supabase)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_EXPIRES_IN="7d"

# AWS S3
AWS_REGION="ap-northeast-2"
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
AWS_S3_BUCKET="your-s3-bucket-name"

# AWS CloudFront
AWS_CLOUDFRONT_DOMAIN="your-distribution.cloudfront.net"
AWS_CLOUDFRONT_KEY_PAIR_ID="your-key-pair-id"
# base64로 인코딩된 RSA 개인키 (PKCS#1 PEM)
# 인코딩 방법 (PowerShell): [System.Convert]::ToBase64String([System.IO.File]::ReadAllBytes("path\to\private-key.pem"))
AWS_CLOUDFRONT_PRIVATE_KEY="base64-encoded-private-key"

# ClamAV Lambda (바이러스 검사용)
AWS_CLAMAV_LAMBDA_ARN="arn:aws:lambda:ap-northeast-2:123456789012:function:clamav-scanner"

# Pinata IPFS (NFT 메타데이터 업로드용)
# https://app.pinata.cloud > API Keys > New Key (Admin ON)
PINATA_JWT="your-pinata-jwt"

# Google Safe Browsing
GOOGLE_SAFE_BROWSING_API_KEY="your-google-api-key"

# Slack
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/xxx/yyy/zzz"

# App
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# Admin (콤마로 여러 주소 구분)
ADMIN_WALLET_ADDRESSES="0xYourWalletAddress"

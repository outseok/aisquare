# Database (Supabase)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_EXPIRES_IN="7d"

# AWS S3
AWS_REGION="ap-northeast-2"
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
AWS_S3_BUCKET="your-s3-bucket-name"

# AWS CloudFront
AWS_CLOUDFRONT_DOMAIN="your-distribution.cloudfront.net"
AWS_CLOUDFRONT_KEY_PAIR_ID="your-key-pair-id"
# base64로 인코딩된 RSA 개인키 (PKCS#1 PEM)
# 인코딩 방법 (PowerShell): [System.Convert]::ToBase64String([System.IO.File]::ReadAllBytes("path\to\private-key.pem"))
AWS_CLOUDFRONT_PRIVATE_KEY="base64-encoded-private-key"

# ClamAV Lambda (바이러스 검사용)
AWS_CLAMAV_LAMBDA_ARN="arn:aws:lambda:ap-northeast-2:123456789012:function:clamav-scanner"

# Pinata IPFS (NFT 메타데이터 업로드용)
# https://app.pinata.cloud > API Keys > New Key (Admin ON)
PINATA_JWT="your-pinata-jwt"

# Google Safe Browsing
GOOGLE_SAFE_BROWSING_API_KEY="your-google-api-key"

# Slack
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/xxx/yyy/zzz"

# App
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# Admin (콤마로 여러 주소 구분)
ADMIN_WALLET_ADDRESSES="0xYourWalletAddress"

# Toss Payments (https://developers.tosspayments.com)
# 테스트: 대시보드 > 개발 > API 키 > 테스트 키
TOSS_CLIENT_KEY="test_ck_your_client_key"
TOSS_SECRET_KEY="test_sk_your_secret_key"

# Hyperledger Fabric
# FABRIC_ENABLED=false 이면 데모 모드 (로그만 출력, 실제 체인코드 미호출)
# FABRIC_ENABLED=true 시 @hyperledger/fabric-gateway @grpc/grpc-js 패키지 설치 필요
FABRIC_ENABLED="false"
FABRIC_CHANNEL="recode-channel"
FABRIC_MSP_ID="Org1MSP"
FABRIC_PEER_ENDPOINT="localhost:7051"
FABRIC_ORDERER_ENDPOINT="localhost:7050"
# 피어 TLS 인증서 경로
FABRIC_TLS_CERT_PATH="./fabric/network/crypto-config/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt"
# 어드민 ID, 인증서, 개인키 (base64)
FABRIC_ADMIN_IDENTITY="admin"
FABRIC_ADMIN_CERT_BASE64="base64-encoded-cert"
FABRIC_ADMIN_KEY_BASE64="base64-encoded-key"
# Admin Wallet (에스크로 예치 계정 식별자)
# Fabric 원장에서 관리자 지갑을 식별하는 ID
FABRIC_ADMIN_WALLET_ID="recode-admin-wallet"
# 배포된 체인코드 이름
FABRIC_WALLET_CHAINCODE="wallet"
